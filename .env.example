# ============================================================
# Energy Callcenter — Umgebungsvariablen
# ============================================================
# Kopiere diese Datei nach `.env` und trage deine Werte ein.
# Alle mit (PFLICHT) markierten Einträge sind notwendig.
# Alle mit (OPTIONAL) markierten Einträge haben sinnvolle Defaults.
#
# Format-Regeln:
# - Keine Leerzeichen um das `=`
# - Strings ohne Anführungszeichen, außer sie enthalten Leerzeichen
# - Zeitangaben im Format HH:MM (24h)
# - Booleans: true oder false
# ============================================================


# ─────────────────────────────────────────────
# CLOSE.COM CRM
# ─────────────────────────────────────────────

# Dein Close API-Key (Settings → API Keys)
# (PFLICHT) — ohne den Key kann der Workflow keine Leads lesen/schreiben
CLOSE_API_KEY=dein-close-api-key-hier

# Deine Close Organisation (z.B. Step2Job)
# (OPTIONAL) — nur zur Info, der Workflow nutzt den Key
CLOSE_ORG_NAME=Step2Job

# Dein Close User (für Tasks und Activities)
# (PFLICHT) — der Workflow erstellt Tasks für dich
CLOSE_USER_ID=user_dein_user_id_hier

# Lead-Status-IDs (aus Close Settings → Customizations → Lead Statuses)
# (PFLICHT) — bestimmt, welcher Status nach dem Gespräch gesetzt wird
# Beispiel-IDs hier sind Platzhalter — mit deinen echten IDs ersetzen
CLOSE_STATUS_POTENTIAL=stat_potential_id
CLOSE_STATUS_BAD_FIT=stat_bad_fit_id
CLOSE_STATUS_QUALIFIED=stat_qualified_id
CLOSE_STATUS_CUSTOMER=stat_customer_id
CLOSE_STATUS_INTERESTED=stat_interested_id
CLOSE_STATUS_CANCELED=stat_canceled_id
CLOSE_STATUS_NOT_INTERESTED=stat_not_interested_id


# ─────────────────────────────────────────────
# CAL.COM TERMINBUCHUNG
# ─────────────────────────────────────────────

# Dein Cal.com API-Key (Settings → Developer → API Keys)
# (PFLICHT) — der Workflow bucht Termine über Cal.com
# Dein Key: cal_live_4efb8ddd720cf73e8515c63d1b37aa16
CALCOM_API_KEY=cal_live_4efb8ddd720cf73e8515c63d1b37aa16

# Dein Cal.com Event-Type-ID
# (PFLICHT) — bestimmt welche Art von Termin gebucht wird
# Energy Erstgespräch, 20 Minuten, ID: 7312892
CALCOM_EVENT_TYPE_ID=7312892

# Deine Cal.com Base-URL
# (OPTIONAL) — Default: https://api.cal.com
CALCOM_BASE_URL=https://api.cal.com


# ─────────────────────────────────────────────
# LIVEKIT VOICE
# ─────────────────────────────────────────────

# LiveKit Server URL (z.B. wss://dein-projekt.livekit.cloud)
# (PFLICHT) — der Workflow ruft über LiveKit an
LIVEKIT_URL=wss://dein-projekt.livekit.cloud

# LiveKit API-Key
# (PFLICHT) — wird für JWT-Erzeugung und AgentDispatch benötigt
LIVEKIT_API_KEY=dein-livekit-api-key

# LiveKit API-Secret
# (PFLICHT) — wird für JWT-Erzeugung benötigt
LIVEKIT_API_SECRET=dein-livekit-api-secret

# LiveKit Agent-ID
# (PFLICHT) — der Voice-Agent, der den Lead anruft
LIVEKIT_AGENT_ID=dein-agent-id

# Telefonnummer, die der Lead sieht (E.164 Format)
# (PFLICHT) — wird an LiveKit CreateSIPParticipant übergeben
CALLER_ID=+491234567890

# LiveKit Webhook Secret (für Signatur-Validierung eingehender Webhooks)
# Wo: LiveKit Dashboard → Settings → Webhooks
# (PFLICHT) — sonst werden LiveKit-Webhooks nicht akzeptiert
LIVEKIT_WEBHOOK_SECRET=dein-webhook-secret-hier


# ─────────────────────────────────────────────
# WORKFLOW-EINSTELLUNGEN
# ─────────────────────────────────────────────

# Maximale Anzahl gleichzeitiger Anrufe
# (OPTIONAL) — Default: 1
MAX_CONCURRENT_CALLS=1

# Maximale Anrufversuche pro Tag pro Lead
# (OPTIONAL) — Default: 3
MAX_ATTEMPTS_PER_DAY=3

# Anruffenster: Start-Uhrzeit (Mo–Sa)
# (OPTIONAL) — Default: 09:00
CALL_WINDOW_START=09:00

# Anruffenster: End-Uhrzeit (Mo–Sa)
# (OPTIONAL) — Default: 18:00
CALL_WINDOW_END=18:00

# Zeitzone für Anruffenster
# (OPTIONAL) — Default: Europe/Berlin
TIMEZONE=Europe/Berlin

# Wie lange ein Lead nach Versuch 1 gewartet wird (Minuten)
# (OPTIONAL) — Default: 60
RETRY_WAIT_MINUTES=60

# Wie lange ein Lead-Lock in Vercel KV gültig ist (Sekunden)
# (OPTIONAL) — Default: 3600 (1 Stunde)
LOCK_TTL_SECONDS=3600


# ─────────────────────────────────────────────
# VERCEL KV (LOCK/RESERVIERUNG)
# ─────────────────────────────────────────────

# Vercel KV REST API URL (aus Vercel Dashboard → Storage → KV)
# (PFLICHT) — wird für das Lock-System benötigt
KV_REST_API_URL=deine-kv-url-hier

# Vercel KV REST API Token
# (PFLICHT) — wird für das Lock-System benötigt
KV_REST_API_TOKEN=dein-kv-token-hier


# ─────────────────────────────────────────────
# WEBHOOK-SICHERHEIT
# ─────────────────────────────────────────────

# Geheimes Token für die Kommunikation Workflow ↔ Voice-Agent
# (PFLICHT) — schützt die Endpunkte /agent/get-kunde, /agent/call-result etc.
AGENT_WEBHOOK_SECRET=dein-geheimes-token-hier
# ============================================================
# ANLEITUNG ZUM AUSFÜLLEN
# ============================================================
#
# Schritt 1: Kopiere diese Datei
#   cp .env.example .env
#
# Schritt 2: Trage alle (PFLICHT)-Werte ein
#   Die mit (OPTIONAL) markierten Werte kannst du erstmal
#   so lassen — sie funktionieren mit den Defaults.
#
# Schritt 3: Speichern und Dev-Server neu starten
#   npm run dev
#
# Wichtig: Die Datei `.env` niemals committen!
# Sie steht bereits in .gitignore.
# ============================================================
